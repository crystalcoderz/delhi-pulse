# Transport Stack live GTFS-RT key (VehiclePositions.pb?key=...)
GTFS_RT_API_KEY=
# Google SERVER key (Worker secret). Restrict to Places API (New) + Routes API.
# Never sent to the browser.
GOOGLE_MAPS_KEY=
# Google BROWSER key (Worker secret). Restrict to Maps JavaScript API only and to
# HTTP referrer https://delhi-pulse.prayaas.workers.dev/*. This one is visible to
# anyone who opens the site, so the restrictions are what protect it.
GOOGLE_MAPS_BROWSER_KEY=
# Optional Cloud-based map style id for the basemap
GOOGLE_MAPS_MAP_ID=
# Live GTFS-RT feed URL used by the local API
GTFS_RT_URL=
