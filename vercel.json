{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "workers/public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://delhi-pulse.prayaas.workers.dev/api/:path*"
    },
    {
      "source": "/:route(journeys|geo|status|days|health|lookup|gmaps-drive)",
      "destination": "https://delhi-pulse.prayaas.workers.dev/:route"
    },
    {
      "source": "/:group(stops|places)/:path*",
      "destination": "https://delhi-pulse.prayaas.workers.dev/:group/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
